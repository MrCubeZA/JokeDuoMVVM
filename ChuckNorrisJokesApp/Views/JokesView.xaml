<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChuckNorrisJokesApp.Views.JokesView"
             Title="Joke Duo">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <Label Text="Joke Duo"
                   Style="{StaticResource Headline}" />

            <Label Text="Chuck Norris joke"
                   FontAttributes="Bold" />
            <Label Text="{Binding ChuckNorrisJoke}" />
            <Label Text="{Binding ChuckNorrisError}"
                   TextColor="Red" />

            <Label Text="Dad joke"
                   FontAttributes="Bold" />
            <Label Text="{Binding DadJoke}" />
            <Label Text="{Binding DadJokeError}"
                   TextColor="Red" />

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}" />
            <Label Text="Loading jokes..."
                   IsVisible="{Binding IsLoading}" />

            <Button Text="Get Jokes"
                    Command="{Binding GetJokeCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
